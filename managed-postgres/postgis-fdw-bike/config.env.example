# Same shape as ../provisioning/config.env. If you already filled that one in:
#     ln -s ../provisioning/config.env config.env
#
# Copy to config.env and fill in your own service. config.env is gitignored;
# this repository is public, so never put a real host or password in a file
# that is not.
#
# The console shows all of these on the service overview page, and the create
# API returns them in its response.

PGHOST=<service>.<id>.c0.<region>.aws.pg.clickhouse.cloud
PGPORT=5432
PGUSER=postgres
PGPASSWORD=<your-password>
PGDATABASE=postgres

# The service only accepts TLS. `require` encrypts but does not verify the
# server certificate; use verify-full with the CA from
# GET /v1/organizations/{orgId}/postgres/{pgId}/caCertificates when it matters.
PGSSLMODE=require

# Only needed if you provision from here (see ../provisioning), or to run
# scripts/clickpipe.sh and scripts/teardown.sh, which call the Cloud API.
# CHC_ORG_ID=<organization-id>
# CHC_KEY_ID=<api-key-id>
# CHC_KEY_SECRET=<api-key-secret>

# ClickHouse Cloud — the service ClickPipes replicates into and pg_clickhouse reads from.
# Used by scripts/clickpipe.sh, scripts/teardown.sh and sql/40-fdw-clickhouse.sql.
CH_HOST=<service>.<region>.aws.clickhouse.cloud     # native TLS endpoint
CH_PORT=9440
CH_USER=default            # on a shared service, a user with rights on CH_DATABASE only
CH_PASSWORD=<password>
CH_DATABASE=mpg_hols_bike  # dedicated database: ClickPipe destination, FDW dbname, dropped by teardown.sh
# Never default, system, pg_sync or ny_citibike: the scripts refuse those.
# CHC_SERVICE_ID=<ClickHouse Cloud service id>   # for clickpipe.sh (Console → service → Settings)
# CH_SECURE=true           # false only for a local ClickHouse without TLS, to try the scripts
