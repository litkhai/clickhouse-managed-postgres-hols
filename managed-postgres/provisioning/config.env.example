# Copy to config.env and fill in your own service. config.env is gitignored;
# this repository is public, so never put a real host or password in a file
# that is not.
#
# The console shows all of these on the service overview page, and the create
# API returns them in its response.

PGHOST=<service>.<id>.c0.<region>.aws.pg.clickhouse.cloud
PGPORT=5432
PGUSER=postgres
PGPASSWORD=<your-password>
PGDATABASE=postgres

# The service only accepts TLS. `require` encrypts but does not verify the
# server certificate; use verify-full with the CA from
# GET /v1/organizations/{orgId}/postgres/{pgId}/caCertificates when it matters.
PGSSLMODE=require

# The CHC_* block is needed by 00-create-service.sh and 99-delete-service.sh,
# not for connecting. They read it from the environment first, then from the
# file named by CHC_ENV_FILE if that is set, then from this file. Keeping the API
# key in a separate file (CHC_ENV_FILE=/path/to/chc.env) means this one never has
# to hold it.
# CHC_ORG_ID=<organization-id>
# CHC_KEY_ID=<api-key-id>
# CHC_KEY_SECRET=<api-key-secret>

# Written by 00-create-service.sh and read by 99-delete-service.sh. Do not fill
# it in by hand unless you are adopting a service that already exists.
# PG_SERVICE_ID=<written by 00-create-service.sh>
