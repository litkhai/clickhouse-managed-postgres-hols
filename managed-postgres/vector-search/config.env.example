# Copy to config.env and fill in. config.env is gitignored — never commit it.
#
#   cp config.env.example config.env

# ---------------------------------------------------------------------------
# ClickHouse Managed Postgres  (Console → Postgres → your service → Connect)
# ---------------------------------------------------------------------------
PGHOST=your-service-abcdef12.xxxxxxxx.c0.us-east-1.aws.pg.clickhouse.cloud
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
PGSSLMODE=require

# Rehearsing locally instead? ./scripts/local-postgres.sh up prints the values.

# ---------------------------------------------------------------------------
# ClickHouse Cloud  (Console → your service → Connect)
# ---------------------------------------------------------------------------
# Port 9440 is the native protocol, which is what pg_clickhouse and
# scripts/clickhouse.sh speak. 8443 is the HTTPS interface, for pasting the
# clickhouse/*.sql files into the SQL console.
#
# These are read: sql/02-load-from-clickhouse.sql takes them through
# scripts/psql.sh, and scripts/clickhouse.sh takes them to run the
# clickhouse/*.sql files. The password never goes on a command line.
#
# On a shared ClickHouse service, use a dedicated user that only has rights on
# mpg_hols_vec rather than `default`.
CH_HOST=your-service.us-east-1.aws.clickhouse.cloud
CH_PORT=9440
CH_USER=default
CH_PASSWORD=
CH_DATABASE=mpg_hols_vec
